# Copy this file to .env and fill in values.

# --- Optional: Strava API sync ---
# Create an API app at https://www.strava.com/settings/api to get these.
# Not required if you only plan to upload GPX files exported from Garmin Connect.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must match the "Authorization Callback Domain" of your Strava API app + this path.
# If running locally: http://localhost:8000/strava/callback
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback

# --- Optional: Garmin auto-sync (unofficial - see README caveats) ---
# You normally DON'T need to set these - use the "Connect Garmin" button in
# the app's own UI instead, which handles login (including MFA) through the
# web form and doesn't need these at all. These are only a fallback the
# background sync can use to re-login on its own if the saved session ever
# expires and you haven't revisited "Connect Garmin" since.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# How often to check Garmin for new activities, in minutes
GARMIN_SYNC_INTERVAL_MINUTES=60

# --- Matching tuning ---
# Average deviation (meters) allowed between two resampled routes to call
# them a match - a flat floor, mainly relevant for short routes. The
# actual allowance used is whichever is larger: this, or the route's own
# length times MATCH_DISTANCE_TOLERANCE below - so a long route
# automatically gets more absolute leeway than a short one does, without
# needing a looser flat number that would also loosen matching for short
# routes. See app/matcher.py's module docstring for why.
MATCH_DISTANCE_THRESHOLD_M=85
# Same allowance, but as a fraction of the route's own length (0.006 =
# 0.6%) - this is what actually matters for anything longer than
# MATCH_DISTANCE_THRESHOLD_M / MATCH_DISTANCE_TOLERANCE (~14km at the
# defaults). Raise this if long rides/runs of the same route aren't
# matching reliably; lower it if unrelated long routes are getting
# grouped together.
MATCH_DISTANCE_TOLERANCE=0.006
# Allowed relative difference in total route length (0.15 = 15%)
MATCH_LENGTH_TOLERANCE=0.15

# Random secret used to sign the session cookie for Strava OAuth state.
APP_SECRET=change-me
