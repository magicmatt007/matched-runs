# Copy this file to .env and fill in values.

# --- Optional: Strava API sync ---
# Create an API app at https://www.strava.com/settings/api to get these.
# Not required if you only plan to upload GPX files exported from Garmin Connect.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must match the "Authorization Callback Domain" of your Strava API app + this path.
# If running locally: http://localhost:8000/strava/callback
STRAVA_REDIRECT_URI=http://localhost:8000/strava/callback

# --- Matching tuning ---
# Average deviation (meters) allowed between two resampled routes to call them a match.
MATCH_DISTANCE_THRESHOLD_M=50
# Allowed relative difference in total route length (0.15 = 15%)
MATCH_LENGTH_TOLERANCE=0.15

# Random secret used to sign the session cookie for Strava OAuth state.
APP_SECRET=change-me
